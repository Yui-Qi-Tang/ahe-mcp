[Unit]
Description=AHE scoped consistency worker
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ahe
EnvironmentFile=/etc/ahe/consistency-worker.env
ExecStart=/opt/ahe/bin/ahe-consistency-worker run
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
