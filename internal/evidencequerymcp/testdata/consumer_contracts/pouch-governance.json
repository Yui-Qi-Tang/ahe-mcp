{
  "consumer": "pouch",
  "owner": "Pouch maintainers; change only together with the matching Pouch parser",
  "derived_from": "pouch internal/ahe/governance.go useAssessment.eligible, useAssessment.ineligible, CheckSources and CheckActions at origin/develop efe0786 (after e3c8a7a and 5319942)",
  "accepted_projection_versions": ["evidence-use-projection/v1", "evidence-use-projection/v2"],
  "outcomes": ["eligible", "blocked", "excluded"],
  "state_digest_prefix": "evidence-use:sha256:",
  "tools": {
    "get_evidence_use_state": {
      "request_fields": ["canonical_ids", "policy"],
      "response_paths": ["assessment.projection_version", "assessment.state_digest", "assessment.policy", "assessment.evaluated_at", "assessment.roots", "assessment.nodes[].node_id", "assessment.nodes[].outcome", "assessment.nodes[].reasons[].code"]
    },
    "check_current_evidence_plan": {
      "request_fields": ["policy", "actions"],
      "response_paths": ["assessment.projection_version", "assessment.state_digest", "assessment.policy", "assessment.evaluated_at", "assessment.roots", "assessment.nodes[].node_id", "assessment.nodes[].outcome", "assessment.nodes[].reasons[].code", "accepted", "actions[].action_id", "actions[].basis_ids"]
    }
  }
}
